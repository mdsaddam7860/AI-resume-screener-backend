# Server
PORT=4000

# Database (SQLite file path used by Prisma)
DATABASE_URL="file:./dev.db"

# LLM Provider config (plug in whichever provider you use)
# The AI service is written as a generic abstraction - see src/services/ai.service.ts
LLM_API_KEY="your-api-key-here"
LLM_API_URL="https://api.anthropic.com/v1/messages"
LLM_MODEL="claude-sonnet-4-6"

# Max file size per resume upload (bytes) - default 5MB
MAX_UPLOAD_SIZE_BYTES=5242880
